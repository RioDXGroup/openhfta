OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it,openai/gpt-oss-20b
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=OpenHFTA

# Formulário de sugestões (SMTP)
# O endpoint só fica habilitado quando host e destinatário estão preenchidos.
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=587
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASSWORD=
FEEDBACK_FROM_EMAIL=
FEEDBACK_TO_EMAIL=
FEEDBACK_CC_EMAIL=
FEEDBACK_SMTP_STARTTLS=true
FEEDBACK_SMTP_SSL=false
FEEDBACK_SMTP_TIMEOUT=15

# Chave pública do Cloudflare Turnstile usada pelo frontend
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile (a chave secreta fica somente no servidor)
TURNSTILE_SECRET=
